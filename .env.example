# Model Router
MODEL_ROUTER_HOST=127.0.0.1
MODEL_ROUTER_PORT=3900

# Required before Credential storage is enabled.
# Never commit the real value.
MODEL_ROUTER_MASTER_KEY=

# Application API token configuration will be added in later v0.1 steps.
MODEL_ROUTER_APPLICATION_TOKEN=

# Admin API token configuration will be added in later v0.1 steps.
MODEL_ROUTER_ADMIN_TOKEN=
