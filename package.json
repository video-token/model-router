{
  "name": "@video-token/model-router",
  "version": "0.1.0",
  "description": "Open-source self-hosted AI model router for BYOK, multi-provider routing and failover.",
  "license": "AGPL-3.0",
  "private": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "scripts": {
  "build": "nest build",
  "start": "node dist/main.js",
  "start:dev": "nest start --watch",
  "start:prod": "node dist/main.js",
  "typecheck": "tsc --noEmit",
  "test": "jest",
  "test:watch": "jest --watch",
  "migration:show": "typeorm-ts-node-commonjs migration:show -- -d src/database/data-source.ts",
  "migration:run": "typeorm-ts-node-commonjs migration:run -- -d src/database/data-source.ts",
  "migration:revert": "typeorm-ts-node-commonjs migration:revert -- -d src/database/data-source.ts"
},
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sqlite3": "^5.1.7",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0"
  }
}
